{
	"compilerOptions": {
		"lib": [
			"es6",
			"dom",
			"es2017",
            "es2019"
		],
		"module": "es6",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"outDir": "../media",
		"removeComments": true,
		"strict": true,
		"target": "es6"
	}
}